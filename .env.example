DATABASE_URL=postgres://dare:dare@localhost:5432/dare
APP_URL=http://localhost:3000

# Encrypts the session cookie. Generate with: openssl rand -base64 32
SESSION_SECRET=change-me-to-at-least-32-characters

# Local SSO mock from docker-compose.yml (dev/nyckeln.yaml).
# Production: https://sso.datasektionen.se/op
OIDC_ISSUER=http://localhost:7003
OIDC_CLIENT_ID=dare
OIDC_CLIENT_SECRET=dev-secret

# Hive (mock on :7004 accepts any token). Production: https://hive.datasektionen.se/api/v1
HIVE_URL=http://localhost:7004/api/v1
HIVE_API_TOKEN=aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaa
# Members of this Hive group are admins.
ADMIN_GROUP=darestaben@datasektionen.se
